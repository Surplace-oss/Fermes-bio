{
  "functions": {
    "api/fermes.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/dons.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dons",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}